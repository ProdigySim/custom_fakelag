import os

project = builder.LibraryProject('custom_fakelag')
project.sources += [
  'extension.cpp',
  'wrappers.cpp',
  'NET_LagPacket_Detour.cpp',
  "net_ws_queued_packet_sender.cpp",
  'LagSystem.cpp',
  'PlayerLagManager.cpp',
  os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp'),
]

for sdk_name in Extension.sdks:
  sdk = Extension.sdks[sdk_name]
  if sdk['name'] in ['mock']:
    continue

  for cxx in builder.targets:
    if not cxx.target.arch in sdk['platforms'][cxx.target.platform]:
      continue
    
    binary = Extension.HL2ExtConfig(project, builder, cxx, 'custom_fakelag.ext.' + sdk['extension'], sdk)
    Extension.AddCDetour(binary)

Extension.extensions += builder.Add(project)
